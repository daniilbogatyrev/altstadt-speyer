{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "altstadt-speyer",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ical/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "altstadt-speyer" }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "routes": [{ "pattern": "test.dbogatyrev.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    "SITE_URL": "https://test.dbogatyrev.com",
    "MAIL_FROM": "FeWo Altstadt Speyer <buchung@dbogatyrev.com>",
    // Public Turnstile site key (empty = spam check off). Test key that always passes: 1x00000000000000000000AA
    "TURNSTILE_SITE_KEY": ""
  }
  // Secrets (wrangler secret put <NAME>; locally in .dev.vars):
  // ADMIN_PASSWORD, SIGNING_KEY, ICAL_TOKEN, RESEND_API_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, TURNSTILE_SECRET
}
